{
  "name": "@citation-js/plugin-quickstatements",
  "version": "0.7.0",
  "type": "module",
  "description": "Plugin that takes citation-js input and output QuickStatements.",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test --test-reporter spec test/suite.js",
    "lint": "standard \"src/**/*.js\" \"test/**/*.js\"",
    "type-check": "tsc --noEmit test/types.ts",
    "changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "coverage": "c8 npm test",
    "report": "c8 report --reporter=lcov",
    "preversion": "npm run lint && npm run type-check && npm run test",
    "version": "npm run changelog"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/citation-js/plugin-quickstatements.git"
  },
  "keywords": [
    "Citation.js",
    "Wikidata",
    "QuickStatements"
  ],
  "author": "Egon Willighagen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/citation-js/plugin-quickstatements/issues"
  },
  "homepage": "https://github.com/citation-js/plugin-quickstatements#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "/src",
    "/index.d.ts"
  ],
  "dependencies": {
    "@citation-js/date": "^0.5.0",
    "@citation-js/name": "^0.4.2",
    "html-entities": "^2.6.0",
    "wikibase-sdk": "^11.6.5"
  },
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-doi": "^0.9.0",
    "@citation-js/plugin-isbn": "^0.5.0",
    "@citation-js/plugin-pubmed": "^0.4.0",
    "c8": "^12.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "standard": "^17.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@citation-js/core": ">=0.6.0 <1.0"
  }
}
